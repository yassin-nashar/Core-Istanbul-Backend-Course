{
  "info": {"name": "Event Booking Security Audit", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Student business-flow collection. Investigate the seven categories listed in README."},
  "variable": [{"key":"token","value":""},{"key":"refreshToken","value":""},{"key":"eventId","value":""},{"key":"bookingId","value":""}],
