{
  "compilerOptions": {
    // يحتوي هذا القسم على جميع إعدادات مترجم TypeScript.
    "target": "ES2022",
    // يحوّل الكود إلى JavaScript متوافق مع ميزات ECMAScript 2022.
    "module": "NodeNext",
    // يستخدم نظام الوحدات الخاص بإصدارات Node.js الحديثة ويدعم ESM.
    "moduleResolution": "NodeNext",
    // يجعل TypeScript يبحث عن الملفات والوحدات بالطريقة التي يستخدمها Node.js.
    "rootDir": "src",
    // يحدد أن ملفات TypeScript الأصلية موجودة داخل مجلد src.
    "outDir": "dist",
    // يضع ملفات JavaScript الناتجة عن البناء داخل مجلد dist.
    "strict": true,
    // يفعّل جميع فحوصات الأنواع الصارمة لاكتشاف الأخطاء مبكرًا.
    "esModuleInterop": true,
    // يسهّل استيراد الحزم التي تستخدم CommonJS داخل مشروع ESM.
    "forceConsistentCasingInFileNames": true,
    // يمنع اختلاف حالة الأحرف في أسماء الملفات بين أنظمة التشغيل.
    "skipLibCheck": true
    // يتجاوز فحص ملفات تعريف الأنواع الخارجية لتسريع عملية الفحص.
  },
  "include": ["src/**/*.ts"]
  // يطلب من TypeScript تضمين جميع ملفات .ts الموجودة داخل مجلد src.
}
