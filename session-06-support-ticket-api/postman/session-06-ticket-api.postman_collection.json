{
  "info": {
    "name": "Session 06 Ticket API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "ticketId", "value": "replace-with-created-ticket-id" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "List tickets",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets" }
    },
    {
      "name": "Create ticket",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Cannot sign in\",\n  \"description\": \"The login form rejects my password\",\n  \"priority\": \"high\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "Get ticket",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/{{ticketId}}" }
    },
    {
      "name": "Update ticket",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Delete ticket",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tickets/{{ticketId}}" }
    }
  ]
}
